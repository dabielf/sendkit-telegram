{
	"name": "sendkit-workspace",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:cli": "bun run packages/cli/src/index.ts",
		"dev:local-mcp": "bun run packages/local-mcp/src/index.ts",
		"dev:remote-mcp": "bun run --cwd apps/remote-mcp dev",
		"deploy:remote-mcp": "bun run --cwd apps/remote-mcp deploy"
	}
}
